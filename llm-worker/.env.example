# Cấu hình local; không đặt dữ liệu CV hoặc giá trị bí mật tại đây.
# Token chỉ qua biến môi trường tiến trình do chủ dự án cấp.
# Không thêm key CVC_LLM_WORKER_TOKEN vào file .env; không commit .env.

# === Cơ bản ===
# Chọn nhà cung cấp local; thử ollama với model đã chuẩn bị.
CVC_LLM_PROVIDER=ollama
# Tag model đã chuẩn bị, bắt buộc khi chạy; thử synthetic-model với mock trong test.
# CVC_LLM_MODEL=
# Chế độ trích xuất; thử whole để gọi toàn văn trước, mặc định blocks.
CVC_LLM_MODE=blocks
# Địa chỉ Ollama chỉ cho phép HTTP loopback; thử http://127.0.0.1:11434.
CVC_LLM_BASE_URL=http://127.0.0.1:11434
# Timeout từng thao tác socket (giây); thử 120, luôn lớn hơn 0.
CVC_LLM_TIMEOUT_S=120
# Số khối kinh nghiệm tối đa được gọi; thử 20 hoặc 0 để chỉ lấy header.
CVC_LLM_MAX_BLOCKS=20

# === Tối ưu (đang tắt) ===
# Chọn tên công ty/chức danh gọn nhưng vẫn nguyên văn nguồn; thử clean, mặc định raw.
CVC_LLM_NAME_STYLE=raw
# Cắt tên bằng quy tắc sau validation, giữ chuỗi con và evidence; thử on, mặc định off.
CVC_LLM_NAME_TRIM=off
# Chọn cách đọc ngày kinh nghiệm mở rộng; thử v2, mặc định v1.
CVC_LLM_DATES=v1
# Tắt văn bản schema để giảm prompt; thử false, mặc định giữ true.
CVC_LLM_PROMPT_SCHEMA_TEXT=true
# Tắt phần personal trong whole để giảm prompt; thử false, mặc định true.
CVC_LLM_WHOLE_PERSONAL=true
# Giới hạn token đầu ra để giảm thời gian; thử 2048, trống là không giới hạn riêng.
CVC_LLM_MAX_OUTPUT_TOKENS=
# Giữ model trong bộ nhớ để giảm lần tải; thử 10m, trống dùng mặc định Ollama.
CVC_LLM_KEEP_ALIVE=
# Tỷ lệ ký tự/token khi chọn context whole; thử 3, mặc định 2.5.
CVC_LLM_CTX_CHARS_PER_TOKEN=2.5
# Bật thêm bậc context 12288; thử true, mặc định false.
CVC_LLM_CTX_FINE_TIERS=false
# Bật phát hiện tràn context và retry một lần ở bậc kế; thử true, mặc định false.
CVC_LLM_CTX_GUARD=false
# Chọn evidence theo dòng để giảm đầu ra; thử lines, mặc định quote.
CVC_LLM_EVIDENCE=quote
# Bật rút gọn đầu vào; thử true, mặc định false.
CVC_LLM_TRIM_INPUT=false
# Khi rút gọn, bỏ section ngoài phạm vi; thử true, mặc định false.
CVC_LLM_TRIM_SECTIONS=false
# Cụm từ được bỏ khi rút gọn, phân cách bằng |; thử Synthetic footer, trống là không thêm.
CVC_LLM_TRIM_PHRASES=
# Model dự phòng khi chất lượng chưa đạt; thử tag model local thứ hai, trống là tắt.
CVC_LLM_FALLBACK_MODEL=
# Ngưỡng tỷ lệ kinh nghiệm bị bỏ để gọi dự phòng; thử 0.3, phạm vi (0, 1].
CVC_LLM_FALLBACK_DROP_RATIO=0.3

# === Nâng cao ===
# Context mặc định cho header/blocks; thử 8192, từ 1 đến 1048576.
CVC_LLM_NUM_CTX=8192
# Timeout cho whole (giây); thử 900, luôn lớn hơn 0.
CVC_LLM_WHOLE_TIMEOUT_S=900
# Nhiệt độ sinh văn bản; thử 0 để ổn định, phạm vi 0 đến 2.
CVC_LLM_TEMPERATURE=0
# Bật suy luận của model hỗ trợ; thử true, mặc định false.
CVC_LLM_THINK=false

# === Backend ===
# Origin backend không có path hoặc dấu / cuối; thử http://127.0.0.1:8080.
CVC_LLM_BACKEND_URL=http://127.0.0.1:8080
# Phiên bản worker dùng làm provenance; thử dev.
CVC_LLM_WORKER_VERSION=dev
# Tên worker cho log, để comment để tự tạo; thử synthetic-worker-42.
# CVC_LLM_WORKER_NAME=
# Khoảng nghỉ polling (giây); thử 5, phạm vi 1 đến 300.
CVC_LLM_POLL_S=5
# Timeout HTTP backend (giây); thử 10, phạm vi 1 đến 120.
CVC_LLM_HTTP_TIMEOUT_S=10
# Số lần thử HTTP backend tối đa; thử 3, phạm vi 1 đến 10.
CVC_LLM_MAX_HTTP_ATTEMPTS=3
# Mức log nội dung an toàn; thử INFO, nhận DEBUG/INFO/WARNING/ERROR.
CVC_LLM_LOG_LEVEL=INFO

# === Chuẩn hóa tên công ty/chức danh ===
# Số chuỗi tối đa mỗi claim normalize; mặc định 50, phạm vi 1 đến 50.
# Khóa CVC_NORM_ được đọc riêng với các khóa CVC_LLM_ của pull.
CVC_NORM_BATCH=50
# normalize dùng lại backend/token trong môi trường, poll/HTTP/log/provider phía trên.
# Token CVC_LLM_WORKER_TOKEN chỉ đặt trong môi trường tiến trình, không lưu vào file này.
