# =====================================================================
# Mẫu llm-worker/.env (WSL). Chép thành .env rồi điền; không đặt dữ liệu CV hoặc giá trị bí mật ở đây.
# Token chỉ qua biến môi trường tiến trình CVC_LLM_WORKER_TOKEN; có key token trong file là lỗi TOKEN_IN_ENV_FILE.
# Ưu tiên: tham số CLI > biến môi trường > file này. Sửa file xong: Ctrl+C rồi chạy lại pull/normalize.
# Hướng dẫn đầy đủ: docs/RUN_LOCAL.md; chi tiết từng tối ưu: llm-worker/README.md.
# =====================================================================

# ---------------------------------------------------------------------
# A. CƠ BẢN
# ---------------------------------------------------------------------
# Nhà cung cấp model local; ollama cho chạy thật, mock chỉ dùng trong test.
CVC_LLM_PROVIDER=ollama
# Chỉ cho openai/anthropic; Ollama để trống.
# CVC_LLM_REASONING_EFFORT=
# Key API đặt bằng biến môi trường OPENAI_API_KEY/ANTHROPIC_API_KEY.
# Tag model Ollama đã pull (bắt buộc khi chạy).
CVC_LLM_MODEL=qwen3:4b
# Địa chỉ Ollama, chỉ cho phép HTTP loopback.
CVC_LLM_BASE_URL=http://127.0.0.1:11434
# Timeout mỗi thao tác socket với Ollama (giây), > 0.
CVC_LLM_TIMEOUT_S=120
# whole = gửi cả CV một lần (đang dùng); blocks = cắt CV thành nhiều khối (mặc định code).
CVC_LLM_MODE=whole
# Timeout lần gọi toàn văn của mode whole (giây), > 0.
CVC_LLM_WHOLE_TIMEOUT_S=900
# Context cho lần gọi thông tin cá nhân (whole) và cho mọi khối (blocks), 1..1048576.
CVC_LLM_NUM_CTX=8192
# Số khối kinh nghiệm tối đa (chỉ mode blocks); 0 = chỉ lấy header.
CVC_LLM_MAX_BLOCKS=20
# Nhiệt độ sinh, 0..2; 0 để cùng CV cho cùng kết quả.
CVC_LLM_TEMPERATURE=0
# Suy luận "thành tiếng" của model; false để nhanh hơn.
CVC_LLM_THINK=false

# ---------------------------------------------------------------------
# B. ĐANG BẬT (đã đo bằng bench, xem llm-worker/README.md)
# ---------------------------------------------------------------------
# Giữ model trong bộ nhớ giữa các CV; -1 = mãi mãi (đổi 30m nếu bật model dự phòng).
CVC_LLM_KEEP_ALIVE=-1
# Lần gọi toàn văn không viết thông tin cá nhân (lấy ở lần gọi thứ hai), nhanh hơn ~33% (O4).
CVC_LLM_WHOLE_PERSONAL=false
# clean = dặn model chép tên công ty/chức danh gọn, tách "A -> B" (A1); mặc định code raw.
CVC_LLM_NAME_STYLE=clean
# v2 = đọc ngày mở rộng như "May 21", "08.2022" (A2); mặc định code v1.
# v3 = thêm tháng viết tắt/sai liền kề, khoảng trắng tháng/năm và khoảng mở ở chế độ quote (E13 A).
CVC_LLM_DATES=v2
# on = code tự cắt phần thừa của tên sau validation, vẫn là chuỗi con của CV (A4); mặc định off.
CVC_LLM_NAME_TRIM=on
# strict giữ hành vi cũ; tolerant chỉ nới so khớp title/company/period kinh nghiệm (E13 B).
# CVC_LLM_QUOTE_MATCH=strict
# v1 giữ prompt cũ; v3 thêm chỉ dẫn tách vai trò, nhận diện công ty và quét toàn CV (E13 C).
# Khi NAME_TRIM=on, v3 chỉ cắt hậu tố title mới nếu khớp tên lõi công ty.
# CVC_LLM_PROMPT_RULES=v1

# ---------------------------------------------------------------------
# C. TẮT CÓ LÝ DO
# ---------------------------------------------------------------------
# Ký tự/token khi chọn context whole; máy chạy thật dùng 3.5 CÙNG CTX_GUARD=true (bench v3).
# Mẫu giữ 2.5 vì test llm-worker khóa CTX_GUARD=false trong file mẫu; 3.5 không có guard có thể bị cắt CV.
CVC_LLM_CTX_CHARS_PER_TOKEN=2.5
# Chốt tràn context, tự gọi lại ở bậc lớn hơn (O9); bật true cùng CTX_CHARS_PER_TOKEN=3.5 trên máy chạy thật.
CVC_LLM_CTX_GUARD=false
# false làm mất họ tên ở 4/10 CV (bench v1/v2): giữ true.
CVC_LLM_PROMPT_SCHEMA_TEXT=true
# lines sai nhiều và không nhanh hơn (bench v3): giữ quote.
CVC_LLM_EVIDENCE=quote
# Rút gọn đầu vào gần như không bớt được chữ trên CV thật (O6): để tắt.
CVC_LLM_TRIM_INPUT=false
# Bỏ section ngoài phạm vi khi rút gọn; chỉ có tác dụng khi TRIM_INPUT=true.
CVC_LLM_TRIM_SECTIONS=false
# Cụm dòng cần bỏ khi rút gọn, ngăn bằng |; trống = không thêm.
CVC_LLM_TRIM_PHRASES=
# Bậc context 12288 mịn hơn; dễ làm model nạp lại, chưa đo: để tắt.
CVC_LLM_CTX_FINE_TIERS=false
# Trần token đầu ra; trống = không giới hạn (lần gọi toàn văn tối đa ~1.730 token).
CVC_LLM_MAX_OUTPUT_TOKENS=
# Model dự phòng khi bỏ quá nhiều kinh nghiệm (O8); trống = tắt, chưa đo.
CVC_LLM_FALLBACK_MODEL=
# Tỷ lệ kinh nghiệm bị bỏ để gọi model dự phòng, (0, 1]; chỉ dùng khi có FALLBACK_MODEL.
CVC_LLM_FALLBACK_DROP_RATIO=0.3
# Tên worker cho log khi chạy 2 worker song song (O7); giá trị rỗng không hợp lệ nên để comment.
# CVC_LLM_WORKER_NAME=local-1

# ---------------------------------------------------------------------
# D. KẾT NỐI
# ---------------------------------------------------------------------
# Origin backend, không path/dấu / cuối; HTTP chỉ cho 127.0.0.1/localhost/[::1].
CVC_LLM_BACKEND_URL=http://127.0.0.1:8080
# Phiên bản worker ghi vào provenance kết quả.
CVC_LLM_WORKER_VERSION=dev
# Khoảng nghỉ giữa hai lần hỏi việc (giây), 1..300.
CVC_LLM_POLL_S=5
# Timeout HTTP tới backend (giây), 1..120.
CVC_LLM_HTTP_TIMEOUT_S=10
# Số lần thử HTTP tối đa, 1..10.
CVC_LLM_MAX_HTTP_ATTEMPTS=3
# Mức log an toàn: DEBUG/INFO/WARNING/ERROR.
CVC_LLM_LOG_LEVEL=INFO
# Số tên mỗi lô normalize, 1..50; máy chạy thật dùng 10 (lô lớn dễ quá lease 600s).
# Mẫu giữ 50 vì test llm-worker khóa giá trị này trong file mẫu.
CVC_NORM_BATCH=50
