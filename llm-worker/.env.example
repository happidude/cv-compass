# Cấu hình local; không đặt dữ liệu CV hoặc giá trị bí mật tại đây.
CVC_LLM_PROVIDER=ollama
# Điền tag model đã chuẩn bị.
CVC_LLM_MODEL=
# Chỉ cho phép HTTP loopback.
CVC_LLM_BASE_URL=http://127.0.0.1:11434
# Timeout hữu hạn, lớn hơn 0 (giây cho từng thao tác socket).
CVC_LLM_TIMEOUT_S=120
# Số khối kinh nghiệm tối đa, số nguyên từ 0.
CVC_LLM_MAX_BLOCKS=20
# Nhiệt độ hữu hạn từ 0 đến 2.
CVC_LLM_TEMPERATURE=0
# Chỉ true hoặc false, không phân biệt hoa thường trong file/môi trường.
CVC_LLM_THINK=false
# Tùy chọn: số nguyên từ 1 đến 1048576; để trống thì không gửi.
CVC_LLM_NUM_CTX=
