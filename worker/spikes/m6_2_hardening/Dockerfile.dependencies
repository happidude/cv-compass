ARG RUNTIME_IMAGE=cvcompass-m6-runtime:build
FROM ${RUNTIME_IMAGE}
USER 0:0
RUN /opt/python/bin/python3 -m venv /opt/cv-venv && mkdir /request /opt/worker && chown -R 65532:65532 /opt/cv-venv
COPY wheels/ /wheels/
COPY requirements.lock requirements-test.lock /locks/
USER 65532:65532
ENV PATH=/opt/cv-venv/bin:/usr/local/bin:/usr/bin:/bin PIP_CACHE_DIR=/tmp/pip-cache PYTHONNOUSERSITE=1
RUN python -m pip install --no-index --find-links /wheels --only-binary=:all: --require-hashes -r /locks/requirements.lock -r /locks/requirements-test.lock && python -m pip check && python -c "import sys; assert sys.prefix != sys.base_prefix; assert not any('/opt/python/lib/python3.14/site-packages' == p for p in sys.path)"
