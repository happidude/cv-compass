root = true

[*]
charset = utf-8
indent_style = space
indent_size = 4
end_of_line = lf
insert_final_newline = true

[frontend/**]
indent_size = 2

[*.{json,yaml,yml,css}]
indent_size = 2

[*.bat]
end_of_line = crlf

[*.md]
trim_trailing_whitespace = false

# Canonical OCR artifacts keep their existing bytes; exclude them from formatting.
[backend/src/main/resources/ocr/ocr-v1.{schema,limits}.json]
end_of_line = crlf
