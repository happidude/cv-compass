{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(gh pr create --draft:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr edit:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.env)",
      "Read(./secrets/**)",
      "Read(./credentials/**)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./**/*.pdf)",
      "Read(./storage/**)",
      "Read(./uploads/**)",
      "Read(./worker/storage/**)",
      "Read(./worker/uploads/**)",
      "Read(./worker/sample_cvs/**)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push origin main:*)",
      "Bash(git reset --hard:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh release:*)",
      "Bash(gh secret:*)",
      "Bash(gh repo edit:*)",
      "Bash(gh api -X DELETE:*)",
      "Bash(git push origin HEAD:main:*)",
      "Bash(git push origin +*:*)",
      "Bash(gh pr ready:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git push origin --force:*)",
      "Bash(git push origin -f:*)",
      "Bash(git push origin --delete:*)",
      "Bash(git push -u origin main:*)",
      "Bash(git add -f:*)",
      "Bash(git add --force:*)",
      "Bash(git commit --no-verify:*)",
      "Bash(git commit -n:*)",
      "Bash(git commit --amend:*)",
      "Read(./**/.env.*)",
      "Read(./**/*.p12)",
      "Read(./**/*.pfx)",
      "Read(./**/secrets/**)",
      "Read(./**/credentials/**)"
    ]
  }
}
