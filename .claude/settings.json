{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.env)",
      "Read(./secrets/**)",
      "Read(./credentials/**)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./**/*.pdf)",
      "Read(./storage/**)",
      "Read(./uploads/**)",
      "Read(./worker/storage/**)",
      "Read(./worker/uploads/**)",
      "Read(./worker/sample_cvs/**)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push origin main:*)",
      "Bash(git reset --hard:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh release:*)",
      "Bash(gh secret:*)",
      "Bash(gh repo edit:*)",
      "Bash(gh api -X DELETE:*)"
    ]
  }
}
