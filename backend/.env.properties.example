# =====================================================================
# Mẫu backend/.env.properties (local). Chép thành .env.properties rồi điền mọi <...>.
# Backend tự đọc file này khi chạy từ thư mục backend/ (spring.config.import).
# Không commit .env.properties; không ghi token thật, chỉ ghi SHA-256 của token.
# Đường dẫn Windows luôn viết bằng dấu / (vd D:/cv_compass_private/storage); \ là ký tự đặc biệt.
# Hướng dẫn đầy đủ: docs/RUN_LOCAL.md.
# =====================================================================

# ---------------------------------------------------------------------
# A. CƠ BẢN
# ---------------------------------------------------------------------
# Kiểu lưu PDF gốc; local là kiểu duy nhất hiện có.
CV_STORAGE_PROVIDER=local
# Thư mục riêng lưu PDF gốc, ngoài repo, không trùng/lồng với inbox nhập tự động.
CV_STORAGE_ROOT=<D:/thư-mục-riêng/storage>
# false để cookie đăng nhập chạy trên http://localhost; production phải true + HTTPS.
CV_SESSION_SECURE=false
# Mức log gốc: INFO (thường dùng), DEBUG khi cần soi lỗi.
CV_LOG_LEVEL=INFO
# Để trống = log dạng đọc được; logstash = log JSON (xem backend/LOGGING.md).
CV_LOG_FORMAT=
# Tên đăng nhập admin tạo lúc backend khởi động trên DB chưa có user (xóa 3 dòng sau lần đăng nhập đầu).
cv.security.provision.username=<tên-đăng-nhập>
# File chứa bcrypt hash mật khẩu admin (1 dòng $2y$12$...), đường dẫn tuyệt đối dùng dấu /.
cv.security.provision.hash-file=<D:/thư-mục-riêng/secrets/admin.hash>
# Vai trò của user được tạo: ADMIN để dùng /api/admin/** (import catalog, rebuild index).
cv.security.provision.role=ADMIN

# ---------------------------------------------------------------------
# B. ĐANG BẬT (cấu hình chạy tốt nhất hiện tại)
# ---------------------------------------------------------------------
# Bật vòng đời job OCR.
CV_OCR_ENABLED=true
# Bật API nội bộ cho OCR worker kéo việc.
CV_OCR_INTEGRATION_ENABLED=true
# local = nhận OCR cho mọi PDF upload; synthetic-only (mặc định code) chỉ nhận PDF mẫu đã đăng ký.
CV_OCR_ADMISSION_MODE=local
# Tên vùng triển khai OCR, bắt buộc khi bật OCR; chữ/số/.-_.
CV_OCR_SYNTHETIC_NAMESPACE=cv-compass-local
# Tên profile OCR đang dùng; phải trùng profile_revision trong pull.toml của OCR worker.
CV_OCR_LOCAL_PROFILE_REVISION=<profile>
# Danh sách profile worker local_worker được phép dùng; trùng tên profile ở trên.
cv.ocr.integration.workers.local_worker.profiles[0]=<profile>
# Phiên bản kết quả OCR mà profile trả về; giữ nguyên.
cv.ocr.integration.profiles.<profile>.result-version=cv-compass.ocr/2.0
# Commit git đã build image OCR (40 hex, lấy từ source-version.json của bản build).
cv.ocr.integration.profiles.<profile>.worker-commit=<40 hex>
# Mã image Docker OCR (sha256:<64 hex>, lấy từ images.json của bản build).
cv.ocr.integration.profiles.<profile>.image-id=<sha256:64 hex>
# Dấu vân tay pipeline.toml của OCR worker (64 hex).
cv.ocr.integration.profiles.<profile>.config-fingerprint=<64 hex>
# Phiên bản thư viện + 3 model OCR trong image, JSON 1 dòng lấy từ lần OCR thử.
cv.ocr.integration.profiles.<profile>.engines-json=<{"python":"3.14.8",...} 1 dòng>
# Bật mapping sau OCR (tạo dữ liệu hồ sơ).
CV_MAPPING_ENABLED=true
# File định nghĩa mapping LLM (đường dẫn tuyệt đối dùng dấu /).
cv.mapping.definition-file=<E:/cv-compass>/backend/src/main/resources/mapping/llm-extraction-config-v1.json
# Phải trùng trường "revision" trong file định nghĩa ở trên.
cv.mapping.revision=llm-extraction-v1-r1
# Bật engine REMOTE: llm-worker (lệnh pull) kéo job mapping qua /internal/mapping/v1.
CV_MAPPING_REMOTE_ENABLED=true
# Bật xuất bản kết quả mapping vào hồ sơ ứng viên.
CV_CANDIDATE_PUBLICATION_ENABLED=true
# Bật hàng đợi chuẩn hóa tên công ty/chức danh cho llm-worker (lệnh normalize).
CV_CATALOG_NORMALIZATION_ENABLED=true
# Thời gian giữ một lô chuẩn hóa; 600s đủ cho model local xử lý lô 10 tên (mặc định code 120s).
CV_CATALOG_NORMALIZATION_LEASE_DURATION=600s

# ---------------------------------------------------------------------
# C. TẮT CÓ LÝ DO
# ---------------------------------------------------------------------
# Nhập tự động từ thư mục: tắt khi chạy local/test để chỉ xử lý PDF upload qua UI.
CV_IMPORT_ENABLED=false
# Mapping thủ công (grammar) thay cho LLM: chỉ dùng khi tắt REMOTE; bỏ # ở 2 dòng dưới và comment 2 dòng LLM.
# cv.mapping.definition-file=<E:/cv-compass>/backend/src/main/resources/mapping/personal-info-config-v3.5.json
# cv.mapping.revision=personal-info-grammar-v35-r1
# TEST_DB_* không đặt ở đây: test backend chỉ đọc biến môi trường thật (System.getenv).

# ---------------------------------------------------------------------
# D. KẾT NỐI
# ---------------------------------------------------------------------
# JDBC URL PostgreSQL dev (container cv-compass-postgres từ infra/docker-compose.yml).
DB_URL=jdbc:postgresql://127.0.0.1:5432/cv_compass
# User DB, trùng POSTGRES_USER của compose.
DB_USERNAME=cvcompass
# Mật khẩu DB, trùng POSTGRES_PASSWORD lúc tạo volume (mặc định compose: cvcompass_dev).
DB_PASSWORD=<mật-khẩu-DB>
# SHA-256 (64 hex) của token OCR worker (biến CV_COMPASS_OCR_TOKEN trong WSL).
cv.ocr.integration.workers.local_worker.credential-sha256[0]=<64 hex>
# SHA-256 (64 hex) của token llm-worker (CVC_LLM_WORKER_TOKEN) cho lệnh pull.
cv.mapping.remote.workers.local_llm.credential-sha256[0]=<64 hex>
# SHA-256 (64 hex) của token llm-worker cho lệnh normalize; thường cùng token với pull.
cv.catalog.normalization.workers.local_llm.credential-sha256[0]=<64 hex>
