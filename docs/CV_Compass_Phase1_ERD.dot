digraph CVCompass {
graph [rankdir=LR, bgcolor="white", pad="0.3", nodesep="0.45", ranksep="1.1", splines=polyline, fontname="DejaVu Sans", label="CV COMPASS — PHASE 1 | UPLOAD · OCR · STORAGE · CANDIDATE MATCHING", labelloc=t, fontsize=22, fontcolor="#14324F"];
