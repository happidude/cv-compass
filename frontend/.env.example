# =====================================================================
# Mẫu frontend/.env.local (Vite). Chép thành .env.local rồi sửa nếu cần.
# Mọi biến VITE_* là công khai (trình duyệt đọc được): không đặt mật khẩu/token ở đây.
# Hướng dẫn đầy đủ: docs/RUN_LOCAL.md.
# =====================================================================

# ---------------------------------------------------------------------
# A. CƠ BẢN
# ---------------------------------------------------------------------
# Tiền tố API phía trình duyệt; giữ /api để đi qua proxy dev của Vite.
VITE_API_BASE_URL=/api
# Múi giờ hiển thị ngày giờ trên UI (tên IANA).
VITE_DISPLAY_TIMEZONE=Asia/Ho_Chi_Minh

# ---------------------------------------------------------------------
# B. ĐANG BẬT
# ---------------------------------------------------------------------
# Dung lượng tối đa mỗi PDF upload (byte), 1..10485760; nên khớp CV_UPLOAD_MAX_FILE_BYTES backend.
VITE_UPLOAD_MAX_BYTES=10485760
# Số file tối đa mỗi lần upload, 1..10; nên khớp CV_BATCH_MAX_FILES backend.
VITE_UPLOAD_MAX_FILES=10
# Chu kỳ hỏi trạng thái CV đang xử lý (ms), 500..60000.
VITE_POLL_INTERVAL_MS=5000
# Thời gian hỏi tối đa cho một CV (ms), 500..3600000; tăng nếu OCR + LLM lâu hơn 2 phút.
VITE_POLL_MAX_MS=120000

# ---------------------------------------------------------------------
# C. TẮT CÓ LÝ DO
# ---------------------------------------------------------------------
# Dữ liệu giả không gọi backend: chỉ để dựng UI/test; bản build production từ chối true.
VITE_MOCK=false

# ---------------------------------------------------------------------
# D. KẾT NỐI
# ---------------------------------------------------------------------
# Origin backend cho proxy dev (không lộ ra trình duyệt); bắt buộc khi VITE_MOCK=false.
API_PROXY_TARGET=http://127.0.0.1:8080
