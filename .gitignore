# IDE files
.idea/
.vscode/
*.iml
*.iws
*.ipr

# Java / Gradle generated files
.gradle/
**/build/
*.class

# Python environments and caches
.venv/
venv/
env/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
*.egg-info/

# Generated outputs
node_modules/
dist/
coverage/
*.log

# Local secrets and credentials
.env
.env.*
!.env.example
!.env.*.example
secrets/
credentials/
*.pem
*.key
*.p12
*.pfx

# Local CV inputs and runtime storage
*.pdf
/storage/
/uploads/
/worker/storage/
/worker/uploads/
/worker/sample_cvs/

# Shared Markdown documentation is tracked; other local doc artifacts stay private.
/docs/**
!/docs/**/
!/docs/**/*.md

# Project agent config is shared; local agent state remains ignored.
/.codex/**
!/.codex/config.toml
!/.codex/agents/
!/.codex/agents/implementer.toml
!/.codex/agents/tester.toml
!/.codex/agents/reviewer.toml

# Claude Code: shared project config is tracked; personal/local state stays ignored.
/.claude/**
!/.claude/settings.json
!/.claude/agents/
!/.claude/agents/*.md
CLAUDE.local.md
**/CLAUDE.local.md

# Keep sensitive/runtime exclusions authoritative after documentation exceptions.
secrets/
credentials/
.env
.env.*
!.env.example
!.env.*.example
*.pem
*.key
*.p12
*.pfx
*.pdf
/docs/api-tests/

